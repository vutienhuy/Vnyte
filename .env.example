# ============================================================================
# Template biến môi trường cho project.
# Copy file này thành `.env.local` (dev) hoặc `.env.production` (build deploy)
# rồi điền giá trị thật.
#
# Mọi request từ web đi qua Gateway (VNT Gateway). Các env legacy
# (NEXT_PUBLIC_API_BASE_URL, AUTH_BASE_URL, HOSPITAL_BASE_URL, HMAC/AES master secret, ...)
# đã bỏ — Gateway trả per-session signingKey + encryptionKey trong QR complete response.
# Xem GATEWAY_MIGRATION_PLAN.md.
#
# Chi tiết xem CONFIG.md
# ============================================================================

# --- CLIENT + SERVER (build-time bake vào client bundle) --------------------
# Mã bệnh viện cho mọi endpoint /api/hospitals/{code}/... và header X-Hospital-Code.
# Đổi giá trị PHẢI build lại (NEXT_PUBLIC_* bake build-time).
NEXT_PUBLIC_HOSPITAL_CODE=92000

# --- SERVER-SIDE (runtime) ---------------------------------------------------

# Gateway base URL. Dev: https://vnttest.ytethongminh.vn. Prod: https://vntgw.onelink.vn.
GATEWAY_BASE_URL=https://vntgw.onelink.vn

# Kiosk payment — mỗi kiosk vật lý cần cặp riêng do VNYTE cấp (argon2 hash trên server).
# TUYỆT ĐỐI KHÔNG dùng chung secret giữa nhiều kiosk — sẽ khó audit log.
KIOSK_DEVICE_CODE=KIOSK-A01
KIOSK_DEVICE_SECRET=your-device-secret-here

# Kiosk OAuth + RSA — xem KIOSK_WEB_OAUTH.md v2.0.
# Mỗi viện có credential + RSA keypair riêng (Cổng BL cấp khi onboarding).
# RSA private key: base64 raw (1 dòng) hoặc PEM PKCS1/PKCS8.
KIOSK_CLIENT_ID=your-client-id
KIOSK_CLIENT_SECRET=your-client-secret
KIOSK_PRIVATE_KEY=your-rsa-private-key-base64
